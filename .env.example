# ============================================================================
# ENVERA MCP server configuration
# ============================================================================

# --- HTTP ---
PORT=3000

# Disable Context JWT verification locally for smoke tests.
# Set to "true" in production (Railway) so paid tool calls are verified.
CONTEXT_AUTH_ENABLED=false

# --- PostgreSQL ---
# Use the Public Network URL for local development.
# On Railway, reference the managed Postgres via the DATABASE_URL variable.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/envera

# When true, skip TLS cert verification (required for Railway's self-signed cert).
DATABASE_SSL_STRICT=false

# --- Redis (optional: falls back to in-memory LRU if REDIS_URL is empty) ---
# Note: .internal URLs only resolve inside Railway's private network.
# Leave commented/empty locally to use the in-memory cache fallback.
# REDIS_URL=redis://default:password@redis.railway.internal:6379
REDIS_TTL_SECONDS=900

# --- Ingestion ---
# Set to "true" to run full ingestion once on server startup (useful for first deploy).
INGEST_ON_STARTUP=false
# Cron schedule for the background ingester. Default: every 6 hours at :07.
INGEST_CRON=7 */6 * * *
# Per-source opt-outs (comma separated: SEC,CFPB,FTC,FINRA,FINCEN,OCC).
INGEST_DISABLE=""

# --- API Keys ---
# FTC / data.gov key — free signup: https://api.data.gov/signup/
DATA_GOV_API_KEY=
# OCC API key for enforcement actions feed.
OCC_API_KEY=

# --- Admin ---
# Set to a random string to enable POST /admin/ingest (leave empty to disable).
ADMIN_INGEST_TOKEN=

# --- Logging ---
LOG_LEVEL=info
